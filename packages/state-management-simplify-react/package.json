{
  "name": "@headlesskit/state-management-simplify-react",
  "version": "1.0.0",
  "description": "React bindings for @headlesskit/state-management-simplify",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@headlesskit/state-management-simplify": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "use-sync-external-store": ">=1.2.0"
  },
  "peerDependenciesMeta": {
    "use-sync-external-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/use-sync-external-store": "^0.0.6",
    "react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "use-sync-external-store": "^1.2.2"
  }
}
