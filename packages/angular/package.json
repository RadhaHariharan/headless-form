{
  "name": "@headless-form/angular",
  "version": "0.1.0",
  "description": "Angular wrapper for headless-form",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/headless-form-angular.mjs"
    }
  },
  "main": "./dist/fesm2022/headless-form-angular.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@headless-form/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17"
  },
  "devDependencies": {
    "@angular/common": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "ng-packagr": "^18.0.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0",
    "zone.js": "^0.14.0"
  }
}