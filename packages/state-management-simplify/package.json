{
  "name": "@headlesskit/state-management-simplify",
  "version": "1.0.0",
  "description": "A small, fast, scalable bare-bones state management solution — ported as @headlesskit/state-management-simplify",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "immer": ">=9.0.6"
  },
  "peerDependenciesMeta": {
    "immer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redux-devtools/extension": "^3.3.0",
    "@types/node": "^20.14.0",
    "immer": "^10.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
